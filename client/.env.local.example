# Copy this file to .env.local and fill in your real Entra ID app registration values.
# Placeholders here let the app boot and show the login screen before real Azure AD is wired up.

VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_TENANT_ID=organizations
VITE_MSAL_REDIRECT_URI=http://localhost:5173
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_API_BASE_URL=/api
