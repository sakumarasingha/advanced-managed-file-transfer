<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e3ed5163-9ba4-4546-8252-d1e5a619d467</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mft.Application\Mft.Application.csproj" />
    <ProjectReference Include="..\Mft.Domain\Mft.Domain.csproj" />
    <ProjectReference Include="..\Mft.Infrastructure\Mft.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Builds the React SPA and copies it into wwwroot so a single App Service can serve both the
    API and the UI (see Program.cs's UseStaticFiles/MapFallbackToFile). Only runs on `dotnet
    publish` (not `dotnet build`/`dotnet run`), so local dev - which runs the Vite dev server
    separately - is unaffected. Requires Node/npm on whatever machine runs `dotnet publish`.
  -->
  <Target Name="BuildClientApp" BeforeTargets="Publish">
    <Exec Command="npm ci" WorkingDirectory="../../client" />
    <Exec Command="npm run build" WorkingDirectory="../../client" />
    <ItemGroup>
      <ClientDist Include="../../client/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientDist)" DestinationFolder="wwwroot/%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!--
      The Web SDK's implicit `wwwroot/**` content glob is evaluated once at project load, before
      this target runs, so files just copied above are otherwise invisible to `dotnet publish`.
      Re-glob wwwroot now (target-scoped items ARE evaluated fresh at execution time) and add
      them directly to the publish output list.
    -->
    <ItemGroup>
      <ClientDistPublished Include="wwwroot/**/*" />
      <ResolvedFileToPublish Include="@(ClientDistPublished)">
        <RelativePath>%(ClientDistPublished.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
